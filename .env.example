# ==============================================================
# InsideHR — environment template
#
# Copy to .env and fill in. Five variables are required; the rest are
# optional and the app degrades cleanly without them.
#
#   cp .env.example .env
# ==============================================================

# --- REQUIRED -------------------------------------------------

# Postgres connection string. Files are stored in the database as well as
# rows, so size the disk and the backup window accordingly.
DATABASE_URL=postgresql://user:password@host:5432/hrms

# Signs the session JWT. Minimum 32 characters. Never reuse across
# environments; changing it invalidates every existing session.
#   openssl rand -base64 32
SESSION_SECRET=

# Absolute base URL, no trailing slash. Used for links in notification and
# password-reset emails, and for receipt links in the expense export.
APP_URL=https://hr.example.com

# Sender for all outbound email. Must be a domain verified with Resend.
EMAIL_FROM="InsideHR <noreply@example.com>"

# Bearer token protecting /api/cron/daily, which sends probation,
# confirmation-letter and work-pass-expiry reminders.
#
# IMPORTANT: if this is unset the cron endpoint is unauthenticated and
# anyone can trigger the daily reminder run.
CRON_SECRET=

# --- OPTIONAL -------------------------------------------------

# Resend API key. Blank disables outbound email entirely: notifications
# are still written to the in-app inbox and each row records that the
# email did not send. Email can also be toggled at runtime in
# Settings -> Notifications without a redeploy.
RESEND_API_KEY=

# Lark adapter for delivering signed letters. Blank falls back to email.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BASE_URL=https://open.larksuite.com

# Route every expense claim to one finance approver, by email. Unset uses
# the normal chain: reporting manager, configured fallback approver, then
# any ADMIN or HR user.
EXPENSE_APPROVER_EMAIL=

# --- Post-deployment checklist --------------------------------
#
#  1. npx prisma migrate deploy
#  2. npm run db:seed              — holidays, leave types, first admin
#     (or npm run db:seed-demo     — DESTRUCTIVE: wipes and seeds demo data)
#  3. npm run letters:placeholder-templates
#     then replace the placeholders at Admin -> Letter Templates
#  4. Admin -> Statutory Rules: the seeded values are unverified and the
#     Singapore overtime figures are Malaysian. Have them confirmed by a
#     qualified employment-law adviser and entered as a new version.
#  5. Admin -> Settings: set the fallback approver, or employees without a
#     reporting manager cannot submit leave.
#  6. Change the first admin's password. New employees are created with
#     'changeme123' and a forced password change.
