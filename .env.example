# Database (Railway Postgres)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Session (min 32 chars, generate with: openssl rand -base64 32)
SESSION_SECRET=

# Google Drive storage
GOOGLE_SERVICE_ACCOUNT_EMAIL=insidehr-drive@insidehr-491010.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_IMPERSONATE_EMAIL=jin@tictag.io

# Letter templates (Google Doc IDs with {{merge}} placeholders).
# The service account needs the Google Docs API scope enabled for domain-wide
# delegation in Workspace admin (in addition to Drive).
GOOGLE_DOCS_EMPLOYMENT_TEMPLATE_ID=
GOOGLE_DOCS_CONFIRMATION_TEMPLATE_ID=

# Email (Resend) — reminders + letter delivery fallback
RESEND_API_KEY=
EMAIL_FROM="InsideHR <noreply@insidehr.com>"

# Lark (notification adapter — DRAFT/infra only; leave blank to stub + use email)
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BASE_URL=https://open.larksuite.com

# Cron protection (Vercel Cron sends this as a Bearer token automatically)
CRON_SECRET=
