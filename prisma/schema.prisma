// This is the InsideHR Prisma schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
  CONTRACTOR
}

enum EmploymentType {
  EMPLOYEE
  CONTRACTOR
  PART_TIME
}

enum UserStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  REJECTED // offer rejected / candidate declined
}

enum Country {
  SG
  MY
}

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  LOGIN
  LOGOUT
  LEAVE_SUBMITTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_CANCELLED
  BALANCE_ADJUSTED
  EXPENSE_SUBMITTED
  EXPENSE_APPROVED
  EXPENSE_REJECTED
  EXPENSE_REIMBURSED
  DOCUMENT_UPLOADED
  DOCUMENT_DELETED
  LEAVE_DELETED
  EXPENSE_DELETED
  REVIEW_CYCLE_CREATED
  REVIEW_CYCLE_OPENED
  REVIEW_CYCLE_EVALUATION_OPENED
  REVIEW_CYCLE_CLOSED
  REVIEW_GOALS_SET
  REVIEW_SUBMITTED
  REVIEW_ACKNOWLEDGED
  REVIEW_REOPENED
  PROBATION_CONFIRMED
  PROBATION_EXTENDED
  PROBATION_NOT_CONFIRMED
  TIME_ENTRY_SUBMITTED
  TIME_ENTRY_APPROVED
  TIME_ENTRY_REJECTED
  TIME_ENTRY_DELETED
  TIME_ENTRY_UNLOCKED
  REWARD_CYCLE_CREATED
  REWARD_CYCLE_APPROVED
  REWARD_CYCLE_PAID
  REWARD_CYCLE_CLOSED
  REWARD_ALLOCATION_SAVED
  REWARD_ALLOCATION_APPROVED
  REWARD_ALLOCATION_PAID
  REWARD_ALLOCATION_CANCELLED
  WORK_PASS_CREATED
  WORK_PASS_UPDATED
  WORK_PASS_DELETED
  BLACKOUT_CREATED
  BLACKOUT_UPDATED
  BLACKOUT_DELETED
  EMPLOYMENT_LETTER_GENERATED
  CONFIRMATION_LETTER_GENERATED
  LETTER_REVIEWED
  LETTER_SIGNED
  LETTER_REJECTED
  LETTER_SENT
  LETTER_REMINDER_SENT
  CONFIRMATION_DATE_SET

  // --- Offboarding (see src/actions/offboarding.ts) ---
  USER_OFFBOARDED
  APPROVALS_REASSIGNED
  DIRECT_REPORTS_REASSIGNED
  SESSION_REVOKED

  // --- Org configuration ---
  SETTING_UPDATED
  STATUTORY_RULES_CREATED
  STATUTORY_RULES_VERIFIED

  // --- Terminal-state reversals (see src/lib/reversal.ts). Every one of
  //     these carries a mandatory `reason` in `details` and is surfaced on
  //     the record's own timeline — a reversal is never invisible. ---
  LEAVE_REVERSED
  EXPENSE_REVERSED
  TIME_ENTRY_REVERSED
  REVIEW_CYCLE_REVERSED
  PERFORMANCE_REVIEW_REVERSED
  REWARD_CYCLE_REVERSED
  REWARD_ALLOCATION_REVERSED
  EMPLOYMENT_LETTER_REVERSED
  LEARNING_LOCKOUT_REVERSED

  // --- Data egress. Anything that pulls company-wide personal data or
  //     pay figures out of the app logs one of these. ---
  PAYROLL_EXPORTED
  EXPENSE_EXPORTED
  RATINGS_EXPORTED
  DOCUMENT_VIEWED
}

enum DocumentScope {
  COMPANY
  EMPLOYEE
}

enum DocumentCategory {
  CONTRACTS
  PAYSLIPS
  MEDICAL
  CERTIFICATIONS
  PERSONAL_DOCS
  OTHER
}

enum AuditEntityType {
  USER
  LEAVE
  EXPENSE
  DOCUMENT
  HOLIDAY
  REVIEW_CYCLE
  PERFORMANCE_REVIEW
  TIME_ENTRY
  REWARD_CYCLE
  REWARD_ALLOCATION
  WORK_PASS
  BLACKOUT
  EMPLOYMENT_LETTER
  LEARNING
  PAYROLL
  SETTING
  STATUTORY_RULES
}

enum HalfDayOption {
  NONE
  AM
  PM
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  FOR_APPROVAL
  APPROVED
  REJECTED
  REIMBURSED
}

enum ExpenseCategory {
  LOCAL_TRANSPORT
  SUBSCRIPTIONS
  OFFICE_EXPENSES
  MEALS_ENTERTAINMENT
  MEDICAL
  COMMUNICATION
  TRAVEL
  TRAINING
  OTHERS
}

// ============================================================
// Performance review enums
// ============================================================

enum ReviewTemplateType {
  FULL
  LITE
  PROBATION
}

enum ReviewCycleStatus {
  DRAFT
  ACTIVE
  EVALUATION
  CLOSED
}

enum PerformanceReviewStatus {
  NOT_STARTED
  GOALS_SET
  IN_EVALUATION
  PENDING_ACKNOWLEDGEMENT
  ACKNOWLEDGED
}

enum GoalType {
  QUALITATIVE
  QUANTITATIVE
}

enum GoalOutcome {
  NOT_EVALUATED
  MISSED
  PARTIAL
  MET
  EXCEEDED
}

enum ProbationDecision {
  CONFIRMED
  EXTENDED
  NOT_CONFIRMED
}

enum TimeEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum RewardCycleStatus {
  DRAFT
  APPROVED
  PAID
  CLOSED
}

enum RewardAllocationStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum BonusType {
  PERFORMANCE
  CONTRACTUAL_13TH
  AD_HOC
}

// Singapore + Malaysia work-pass types most retailers issue.
// CITIZEN / PR is recorded as NONE (no pass needed) for tracking completeness.
enum WorkPassType {
  NONE              // SG citizen, SG PR, MY citizen, MY PR
  SG_WORK_PERMIT    // SG Work Permit (WP) — basic-skilled, sector quota applies
  SG_S_PASS         // SG S Pass — mid-skilled, salary + quota
  SG_EMPLOYMENT_PASS // SG Employment Pass (EP) — professional
  SG_DEPENDANT_PASS // SG Dependant Pass with LOC
  SG_LTVP_PLUS      // SG LTVP+ with LOC
  MY_WORK_PERMIT    // MY foreign worker permit
  MY_EMPLOYMENT_PASS // MY EP I/II/III
  MY_DEPENDANT_PASS // MY Dependant Pass with work endorsement
  OTHER
}

// ============================================================
// Employment / confirmation letters
// ============================================================

enum LetterType {
  EMPLOYMENT   // offer / employment letter, auto-drafted on hire
  CONFIRMATION // post-probation confirmation letter
}

// Lifecycle: a draft is auto-generated → HR reviews → approving officer
// signs → PDF saved to Drive → (confirmation letters) sent via Lark.
enum LetterStatus {
  PENDING_REVIEW    // auto-generated draft, waiting for HR to review
  PENDING_SIGNATURE // HR approved, waiting for the approving officer to sign
  SIGNED            // officer signed; PDF saved to the employee folder
  SENT              // delivered to the employee (confirmation letters, via Lark)
  REJECTED          // rejected at review or signing
  OVERDUE           // confirmation letter not sent by its due date
}

// ============================================================
// Models
// ============================================================

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  gender             String?
  dateOfBirth        DateTime?
  nationality        String?
  profilePhotoUrl    String?

  // Identity / HR records (added for the employment-letter + work-pass flows)
  employeeNumber     String?        @unique // human-facing "Employee ID" entered by HR
  nric               String?        // SG NRIC (locals); foreigners use FIN on the work pass
  passportNumber     String?
  passportExpiry     DateTime?
  company            String?        // legal entity the employee belongs to (pulled into work-pass view)

  position           String?
  department         String?
  employmentType     EmploymentType @default(EMPLOYEE)
  country            Country        @default(SG)
  hourlyRate         Decimal?       @db.Decimal(19, 4)
  normalDailyHours   Decimal?       @db.Decimal(5, 2)
  startDate          DateTime?

  // Probation / confirmation. probationEndDate is auto-computed from
  // startDate + probationMonths; confirmationDate is entered manually by HR.
  probationMonths    Int?           @default(3)
  probationEndDate   DateTime?
  confirmationDate   DateTime?

  reportingManagerId String?
  reportingManager   User?          @relation("ReportsTo", fields: [reportingManagerId], references: [id])
  directReports      User[]         @relation("ReportsTo")
  role               Role           @default(EMPLOYEE)
  status             UserStatus     @default(ACTIVE)
  terminatedAt       DateTime?
  mustChangePassword Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  auditLogs          AuditLog[]
  leaveRequests      LeaveRequest[] @relation("LeaveRequests")
  leaveApprovals     LeaveRequest[] @relation("LeaveApprovals")
  leaveBalances      LeaveBalance[]
  expenses           Expense[]         @relation("UserExpenses")
  expenseApprovals   Expense[]         @relation("ExpenseApprovals")
  reimbursements     Expense[]         @relation("ExpenseReimbursements")
  receiptUploads     ExpenseReceipt[]  @relation("ReceiptUploads")
  approvalActions    ExpenseApproval[] @relation("ExpenseApprovalActions")
  ownDocuments       Document[]        @relation("EmployeeDocuments")
  uploadedDocs       Document[]        @relation("DocumentUploads")
  passwordResetTokens PasswordResetToken[]

  performanceReviewsAsEmployee PerformanceReview[] @relation("ReviewEmployee")
  performanceReviewsAsManager  PerformanceReview[] @relation("ReviewManager")
  createdReviewCycles          ReviewCycle[]       @relation("ReviewCycleCreator")

  timeEntries          TimeEntry[] @relation("UserTimeEntries")
  timeEntryApprovals   TimeEntry[] @relation("TimeEntryApprovals")

  rewardAllocations      RewardAllocation[] @relation("AllocationEmployee")
  proposedAllocations    RewardAllocation[] @relation("AllocationProposer")
  approvedAllocations    RewardAllocation[] @relation("AllocationApprover")
  createdRewardCycles    RewardCycle[]      @relation("RewardCycleCreator")

  workPasses             WorkPass[]

  employmentLetters      EmploymentLetter[] @relation("EmployeeLetters")
  letterReviews          EmploymentLetter[] @relation("LetterReviewers")
  letterApprovals        EmploymentLetter[] @relation("LetterApprovers")
  letterRejections       EmploymentLetter[] @relation("LetterRejecters")

  learningLessons        LearningLessonProgress[]
  learningTests          LearningTestProgress[]
  learningSurvey         LearningSurvey?
  learningMaterialUploads LearningMaterial[] @relation("LearningMaterialUploads")
  moduleLessonsCreated    LearningModuleLesson[] @relation("ModuleLessonCreator")

  careerEvents           CareerEvent[]
  notifications          Notification[]
  letterTemplateUploads  LetterTemplate[] @relation("LetterTemplateUploads")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType AuditEntityType
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime        @default(now())
}

model PublicHoliday {
  id         String   @id @default(uuid())
  country    Country
  date       DateTime
  name       String
  year       Int
  isObserved Boolean  @default(true)
  type       String   @default("PUBLIC_HOLIDAY")

  @@unique([country, date])
  @@index([country, year])
}

model LeaveType {
  id                 String   @id @default(uuid())
  name               String   @unique
  defaultEntitlement Float
  requiresAttachment Boolean  @default(false)
  allowsHalfDay      Boolean  @default(true)
  applicableToAll    Boolean  @default(true)
  createdAt          DateTime @default(now())

  balances LeaveBalance[]
  requests LeaveRequest[]
}

model LeaveBalance {
  id                       String    @id @default(uuid())
  userId                   String
  user                     User      @relation(fields: [userId], references: [id])
  leaveTypeId              String
  leaveType                LeaveType @relation(fields: [leaveTypeId], references: [id])
  year                     Int
  entitlement              Float
  entitlementOverride      Float?
  used                     Float     @default(0)
  pending                  Float     @default(0)
  carryForward             Float     @default(0)
  carryForwardExpiresAt    DateTime?
  adjustment               Float     @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([userId, leaveTypeId, year])
  @@index([userId, year])
}

model LeaveRequest {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation("LeaveRequests", fields: [userId], references: [id])
  leaveTypeId     String
  leaveType       LeaveType     @relation(fields: [leaveTypeId], references: [id])
  startDate       DateTime
  endDate         DateTime
  halfDay         HalfDayOption @default(NONE)
  daysCount       Float
  reason          String?
  attachmentBlobId String?
  attachmentBlob  FileBlob?     @relation(fields: [attachmentBlobId], references: [id])
  attachmentName  String?
  status          LeaveStatus   @default(PENDING)
  approverId      String?
  approver        User?         @relation("LeaveApprovals", fields: [approverId], references: [id])
  approvedAt      DateTime?
  rejectionReason String?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, status])
  @@index([approverId, status])
  @@index([startDate, endDate])
  @@index([attachmentBlobId])
}

model Expense {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation("UserExpenses", fields: [userId], references: [id])
  category       ExpenseCategory
  amount         Decimal         @db.Decimal(19, 4)
  currency       String
  merchant       String
  receiptDate    DateTime
  description    String?
  status         ExpenseStatus   @default(DRAFT)
  approverId     String?
  approver       User?           @relation("ExpenseApprovals", fields: [approverId], references: [id])
  reimbursedAt   DateTime?
  reimbursedById String?
  reimbursedBy   User?           @relation("ExpenseReimbursements", fields: [reimbursedById], references: [id])
  submittedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  receipts   ExpenseReceipt[]
  approvals  ExpenseApproval[]

  @@index([userId, status])
  @@index([approverId, status])
  @@index([receiptDate])
}

model ExpenseReceipt {
  id           String   @id @default(uuid())
  expenseId    String
  expense      Expense  @relation(fields: [expenseId], references: [id])
  blobId       String?
  blob         FileBlob? @relation(fields: [blobId], references: [id])
  fileName     String
  fileSize     Int
  mimeType     String
  uploadedAt   DateTime @default(now())
  uploadedById String
  uploadedBy   User     @relation("ReceiptUploads", fields: [uploadedById], references: [id])

  @@index([expenseId])
  @@index([blobId])
}

model ExpenseApproval {
  id         String    @id @default(uuid())
  expenseId  String
  expense    Expense   @relation(fields: [expenseId], references: [id])
  approverId String
  approver   User      @relation("ExpenseApprovalActions", fields: [approverId], references: [id])
  status     String
  comment    String?
  actedAt    DateTime?
  order      Int       @default(1)
  createdAt  DateTime  @default(now())

  @@index([expenseId])
  @@index([approverId, status])
}

model Document {
  id           String            @id @default(uuid())
  name         String
  scope        DocumentScope     @default(COMPANY)
  category     DocumentCategory  @default(OTHER)
  employeeId   String?
  employee     User?             @relation("EmployeeDocuments", fields: [employeeId], references: [id])
  blobId       String?
  blob         FileBlob?         @relation(fields: [blobId], references: [id])
  fileName     String
  fileSize     Int
  mimeType     String
  uploadedById String
  uploadedBy   User              @relation("DocumentUploads", fields: [uploadedById], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([scope, employeeId])
  @@index([scope, employeeId, category])
  // Every file download resolves what a blob belongs to by querying this.
  @@index([blobId])
}

// ============================================================
// Performance review models
// ============================================================

model ReviewCycle {
  id                       String               @id @default(uuid())
  name                     String
  templateType             ReviewTemplateType   @default(FULL)
  status                   ReviewCycleStatus    @default(DRAFT)
  startDate                DateTime
  endDate                  DateTime
  goalSettingDeadline      DateTime?
  evaluationOpensAt        DateTime?
  evaluationDeadline       DateTime?

  // Configurable rating (FULL/LITE only — null for PROBATION which has no rating)
  ratingScale              Int                  @default(5)
  ratingLabels             Json                 @default("[\"Below\",\"Approaching\",\"Meets\",\"Exceeds\",\"Outstanding\"]")

  // Goal config
  minGoals                 Int                  @default(3)
  maxGoals                 Int                  @default(7)
  goalWeightsEnabled       Boolean              @default(false)

  // Flow toggles
  employeeSelfAssessment   Boolean              @default(false)
  employeeCanComment       Boolean              @default(true)
  requireManagerNarrative  Boolean              @default(true)

  // Retail-specific knobs
  includeSalesTarget       Boolean              @default(false)
  targetCurrency           String?
  includeAttendanceMetric  Boolean              @default(false)

  createdById              String
  createdBy                User                 @relation("ReviewCycleCreator", fields: [createdById], references: [id])
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  reviews                  PerformanceReview[]
  rewardCycles             RewardCycle[]

  @@index([status, endDate])
  @@index([templateType, status])
}

model PerformanceReview {
  id                       String                   @id @default(uuid())
  cycleId                  String
  cycle                    ReviewCycle              @relation(fields: [cycleId], references: [id])

  employeeId               String
  employee                 User                     @relation("ReviewEmployee", fields: [employeeId], references: [id])

  // Snapshot of reporting manager at scope-assignment time
  managerId                String
  manager                  User                     @relation("ReviewManager", fields: [managerId], references: [id])

  status                   PerformanceReviewStatus  @default(NOT_STARTED)

  // Rating (FULL/LITE)
  overallRating            Int?
  managerNarrative         String?

  // Employee response
  employeeAcknowledgement  String?
  employeeSelfAssessment   String?

  // Retail extras (filled when cycle toggles enabled)
  salesTargetAmount        Decimal?                 @db.Decimal(19, 4)
  salesActualAmount        Decimal?                 @db.Decimal(19, 4)
  attendanceDaysWorked     Int?
  attendanceDaysScheduled  Int?
  promotionReady           Boolean?

  // Probation cycles only
  probationDecision        ProbationDecision?

  submittedForEvaluationAt DateTime?
  acknowledgedAt           DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  goals                    Goal[]
  rewardAllocations        RewardAllocation[] @relation("ReviewAllocations")

  @@unique([cycleId, employeeId])
  @@index([managerId, status])
  @@index([employeeId, cycleId])
}

model Goal {
  id              String              @id @default(uuid())
  reviewId        String
  review          PerformanceReview   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  title           String
  description     String?
  goalType        GoalType            @default(QUALITATIVE)

  // Quantitative goals
  targetValue     Decimal?            @db.Decimal(19, 4)
  actualValue     Decimal?            @db.Decimal(19, 4)
  unit            String?

  // Optional weight (0-100); only meaningful when cycle.goalWeightsEnabled
  weight          Int?

  outcome         GoalOutcome         @default(NOT_EVALUATED)
  managerComment  String?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([reviewId])
}

// ============================================================
// Part-time timesheet
// ============================================================

model TimeEntry {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation("UserTimeEntries", fields: [userId], references: [id])
  workDate        DateTime         @db.Date
  startTime       DateTime?
  endTime         DateTime?
  breakMinutes    Int              @default(0)
  hoursWorked     Decimal          @db.Decimal(5, 2)
  description     String?
  isPublicHoliday Boolean          @default(false)
  status          TimeEntryStatus  @default(DRAFT)
  approverId      String?
  approver        User?            @relation("TimeEntryApprovals", fields: [approverId], references: [id])
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, workDate])
  @@index([userId, status])
  @@index([approverId, status])
  @@index([workDate])
}

// ============================================================
// Rewards / Bonus allocation
// ============================================================

model RewardCycle {
  id                  String              @id @default(uuid())
  name                String
  description         String?
  status              RewardCycleStatus   @default(DRAFT)
  reviewCycleId       String?             // optional link to a performance ReviewCycle
  reviewCycle         ReviewCycle?        @relation(fields: [reviewCycleId], references: [id])
  totalPoolAmount     Decimal?            @db.Decimal(19, 4)
  currency            String              @default("MYR")
  payoutDate          DateTime?
  createdById         String
  createdBy           User                @relation("RewardCycleCreator", fields: [createdById], references: [id])
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  allocations         RewardAllocation[]

  @@index([status, payoutDate])
}

model RewardAllocation {
  id              String                  @id @default(uuid())
  cycleId         String
  cycle           RewardCycle             @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  employeeId      String
  employee        User                    @relation("AllocationEmployee", fields: [employeeId], references: [id])

  linkedReviewId  String?
  linkedReview    PerformanceReview?      @relation("ReviewAllocations", fields: [linkedReviewId], references: [id])

  bonusType       BonusType               @default(PERFORMANCE)
  amount          Decimal                 @db.Decimal(19, 4)
  currency        String                  // snapshot from cycle at create time
  rationale       String?

  status          RewardAllocationStatus  @default(DRAFT)

  proposedById    String?
  proposedBy      User?                   @relation("AllocationProposer", fields: [proposedById], references: [id])

  approverId      String?
  approver        User?                   @relation("AllocationApprover", fields: [approverId], references: [id])
  approvedAt      DateTime?
  paidAt          DateTime?

  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([cycleId, employeeId, bonusType])
  @@index([cycleId, status])
  @@index([employeeId])
}

// ============================================================
// Work passes — SG/MY foreign worker permits + expiry tracking
// ============================================================

model WorkPass {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  passType    WorkPassType
  passNumber  String?       // optional; some users may have multiple passes over time
  workPermitNumber String?  // Work Permit No. (distinct from the generic pass number)
  finNumber   String?       // FIN (foreign worker identification number)
  applicationDate DateTime?
  approvalDate    DateTime?
  issueDate   DateTime?
  expiryDate  DateTime?     // null = no expiry (e.g. NONE)
  levy        Decimal?      @db.Decimal(19, 4) // monthly levy for foreign workers, optional
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([expiryDate])
}

// ============================================================
// Employment / confirmation letters
//   Auto-drafted on hire (EMPLOYMENT) or post-probation (CONFIRMATION),
//   reviewed by HR, signed by a per-letter approving officer, the PDF
//   stored in the employee's Drive folder, and (for confirmation letters)
//   delivered via the notification adapter (Lark).
// ============================================================

model EmploymentLetter {
  id                 String       @id @default(uuid())
  employeeId         String
  employee           User         @relation("EmployeeLetters", fields: [employeeId], references: [id], onDelete: Cascade)
  type               LetterType   @default(EMPLOYMENT)
  status             LetterStatus @default(PENDING_REVIEW)

  // HR review of the auto-generated draft
  reviewedById       String?
  reviewedBy         User?        @relation("LetterReviewers", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?

  // Approving officer chosen per-letter; signs via the in-app pad
  approvingOfficerId String?
  approvingOfficer   User?        @relation("LetterApprovers", fields: [approvingOfficerId], references: [id])
  signatureDataUrl   String?      // drawn signature PNG (data URL), embedded into the PDF
  signedAt           DateTime?

  // Rejection (at review or signing)
  rejectedById       String?
  rejectedBy         User?        @relation("LetterRejecters", fields: [rejectedById], references: [id])
  rejectedAt         DateTime?
  rejectionReason    String?

  // The generated PDF.
  blobId             String?
  blob               FileBlob?    @relation(fields: [blobId], references: [id])

  // Delivery + scheduling (mainly confirmation letters)
  dueDate            DateTime?    // date the letter is due to go out (= confirmationDate)
  sentAt             DateTime?
  lastReminderAt     DateTime?    // drives "every 2 days until signed" nudges
  overdue            Boolean      @default(false)

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([status, type])
  @@index([employeeId])
  @@index([approvingOfficerId, status])
  @@index([blobId])
}

// ============================================================
// Blackout windows — block leave during retail peaks (CNY, Hari Raya, etc.)
// ============================================================

model BlackoutWindow {
  id          String   @id @default(uuid())
  name        String
  reason      String?
  // Country scope. null = applies to all countries.
  country     Country?
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  // If true, leave during this window is hard-blocked; else soft-warning only.
  hardBlock   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([country, startDate, endDate])
}

// ============================================================
// Learning (LMS) — onboarding journey progress synced from the
// iORA Learning Hub. The journey is a fixed set of lessons and
// their matching unit tests (lesson1..3 / test1..3); lesson/test
// ids mirror the LMS course definitions (data.jsx).
// ============================================================

// Per-lesson part completion (slides → PDF → video).
model LearningLessonProgress {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "lesson1" | "lesson2" | "lesson3" (matches the LMS course ids)
  lessonId    String
  slidesDone  Boolean   @default(false)
  pdfDone     Boolean   @default(false)
  videoDone   Boolean   @default(false)
  // set when all three parts are complete
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
}

// Per-test assessment state (attempts, lockout, best score, pass).
model LearningTestProgress {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "test1" | "test2" | "test3" (the assessment for the matching lesson)
  testId      String
  attempts    Int       @default(0)
  passed      Boolean   @default(false)
  // best score as a 0..1 fraction
  bestScore   Float     @default(0)
  // locked out after MAX_TEST_ATTEMPTS failed attempts → HR follow-up
  locked      Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, testId])
  @@index([userId])
}

// Admin-uploaded lesson content (slides / reading / video / quiz bank) that
// overrides the bundled files in public/materials for the whole team. Keyed
// "<kind>:<lessonNo>" (e.g. "pdf:1"); pptx/pdf bytes live in `data` and are
// served by /api/learning/materials/[key]; video URLs and quiz CSV text live
// in `text`.
model LearningMaterial {
  id           String   @id @default(uuid())
  // "pptx:1" | "pdf:1" | "video:1" | "csv:1" … for lessons 1..3
  key          String   @unique
  // "pptx" | "pdf" | "video" | "csv"
  kind         String
  fileName     String?
  mimeType     String?
  fileSize     Int?
  data         Bytes?
  text         String?
  uploadedById String
  uploadedBy   User     @relation("LearningMaterialUploads", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Admin-created "Module lessons" — the second Learning Hub tab, unlocked once
// the onboarding certificate is earned. Content (slides / reading / video) is
// stored as LearningMaterial rows keyed "<kind>:<moduleLessonId>"; learner
// progress reuses LearningLessonProgress with lessonId = the module lesson id.
model LearningModuleLesson {
  id          String   @id @default(uuid())
  title       String
  summary     String?
  position    Int      @default(0)
  createdById String
  createdBy   User     @relation("ModuleLessonCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One feedback survey per learner, gating the e-certificate.
model LearningSurvey {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clarity     Int
  pace        Int
  usefulness  Int
  comment     String?
  submittedAt DateTime @default(now())
}

// ============================================================
// Career journey — milestones in an employee's life at the company,
// rendered as the "Journey" flow on their own profile. Auto-recorded
// from HR actions (hire, position/department changes, confirmation,
// termination); effectiveDate drives the timeline order.
// ============================================================

enum CareerEventType {
  JOINED
  POSITION_CHANGE
  DEPARTMENT_CHANGE
  CONFIRMED
  TERMINATED
}

model CareerEvent {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          CareerEventType
  title         String          // e.g. "Joined as Sales Associate"
  detail        String?         // e.g. department / company context
  fromValue     String?         // previous position/department for change events
  toValue       String?         // new position/department
  effectiveDate DateTime
  createdAt     DateTime        @default(now())

  @@index([userId, effectiveDate])
}

// ============================================================
// Notifications — the in-app inbox. Every lifecycle event that a human
// needs to know about writes a row here through `notify()`
// (src/lib/notify.ts); email is a secondary channel off the same call.
// Before this existed, everything in the app was discovered by chance
// login.
//
// `emailedAt` / `emailError` record what actually happened on the email
// side, so "the employee was never told" is an answerable question
// rather than a guess.
// ============================================================

enum NotificationType {
  // Leave
  LEAVE_SUBMITTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_CANCELLED
  // Time & attendance
  TIMESHEET_SUBMITTED
  TIMESHEET_APPROVED
  TIMESHEET_REJECTED
  // Expenses
  EXPENSE_SUBMITTED
  EXPENSE_APPROVED
  EXPENSE_REJECTED
  EXPENSE_REIMBURSED
  // Performance
  PERFORMANCE_GOALS_SET
  PERFORMANCE_REVIEW_SUBMITTED
  PERFORMANCE_ACK_REQUIRED
  PERFORMANCE_DEADLINE
  // Rewards
  REWARD_APPROVED
  REWARD_PAID
  // Learning
  LEARNING_LOCKED_OUT
  LEARNING_UNLOCKED
  LEARNING_DUE
  // Work passes / letters / probation
  WORK_PASS_EXPIRING
  WORK_PASS_EXPIRED
  LETTER_READY_FOR_ACTION
  LETTER_SENT
  PROBATION_DUE
  // Cross-cutting
  APPROVAL_REASSIGNED
  STATE_REVERSED
  GENERAL
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String
  linkUrl    String?          // in-app deep link to the record it concerns
  readAt     DateTime?
  emailedAt  DateTime?        // null = email not sent (disabled, failed, or no address)
  emailError String?
  createdAt  DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ============================================================
// Org settings — operational knobs that used to be hardcoded constants
// scattered through the code (carry-forward cap, LMS attempt limit,
// session length, fallback approver). Key/value so adding a knob needs
// no migration; read through the typed accessors in src/lib/settings.ts
// rather than touching this table directly.
//
// This is "what we decided". Statutory rules — "what the law says" —
// live in StatutoryRuleSet below and are reviewed by different people.
// ============================================================

model OrgSetting {
  key       String   @id
  value     Json
  updatedBy String? // User.id of the last editor; null for seeded defaults
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ============================================================
// Statutory rulebook — per-country employment rules (annual leave,
// sick leave banding, overtime multipliers and caps), versioned by
// effective date so a rule change never retroactively rewrites a
// payroll figure or leave entitlement that was already calculated.
//
// `resolveRules(country, asOf)` in src/lib/statutory.ts picks the
// latest set whose effectiveFrom <= asOf.
//
// IMPORTANT: `verifiedBy` is null until a qualified employment-law
// adviser has signed the values off. While it is null the app shows an
// "unverified" banner on every screen that depends on these numbers.
// The seeded values carry over what the code did before and are NOT
// legal advice.
// ============================================================

// ============================================================
// File storage
//
// Files used to live in Google Drive. Storage is now Postgres: the bytes live
// here and every record that owns a file references a blob by id.
//
// Why a separate table rather than a `Bytes` column on Document,
// ExpenseReceipt and EmploymentLetter:
//
//   - `sha256` gives content addressing, so the same file uploaded twice is
//     stored once. That is what makes a mass-push document safe — previously
//     N employees shared one physical Drive file and one of them deleting
//     "their" copy could bin the shared original once the row count hit zero.
//   - `refCount` makes deletion safe: dropping a reference decrements, and the
//     bytes go only when nothing points at them.
//   - Keeping megabytes out of the owning tables means an ordinary
//     `findMany` on Document never risks dragging file contents along with it.
//
// Access to these bytes is never direct — everything goes through
// /api/files/[blobId], which resolves what the blob belongs to and checks
// the caller may see it. See src/lib/fileAccess.ts.
// ============================================================

model FileBlob {
  id        String   @id @default(uuid())
  /** SHA-256 of `data`, hex. Content address — makes identical uploads share a row. */
  sha256    String   @unique
  data      Bytes
  mimeType  String
  fileSize  Int
  /** Number of records pointing at this blob. Bytes are deleted when it hits 0. */
  refCount  Int      @default(0)
  createdAt DateTime @default(now())

  documents        Document[]
  expenseReceipts  ExpenseReceipt[]
  employmentLetters EmploymentLetter[]
  leaveAttachments LeaveRequest[]
  letterTemplates  LetterTemplate[]

  @@index([refCount])
}

// ============================================================
// Letter templates
//
// Letters were generated by copying a Google Doc template, replacing
// {{placeholders}} via the Docs API, and exporting to PDF. With Google
// removed, a template is now a fillable PDF: HR uploads one per letter type
// and the app fills its AcroForm text fields with pdf-lib, then flattens the
// result so the output is not editable.
//
// `fieldNames` is what was actually found in the uploaded PDF, so the admin
// screen can show HR which merge fields their template will receive and
// which of the available ones it is not using.
// ============================================================

model LetterTemplate {
  id           String     @id @default(uuid())
  /** One active template per letter type. */
  type         LetterType @unique
  blobId       String
  blob         FileBlob   @relation(fields: [blobId], references: [id])
  fileName     String
  /** AcroForm text field names detected in the PDF on upload. */
  fieldNames   String[]
  /**
   * True for the built-in template generated by
   * `npm run letters:make-placeholder-templates`. It is deliberately plain and
   * exists so the letters flow works before HR has supplied real stationery —
   * the admin screen flags it as a placeholder.
   */
  isPlaceholder Boolean   @default(false)
  uploadedById String?
  uploadedBy   User?      @relation("LetterTemplateUploads", fields: [uploadedById], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([blobId])
}

model StatutoryRuleSet {
  id            String    @id @default(uuid())
  country       Country
  effectiveFrom DateTime
  rules         Json
  note          String? // what changed and why, for the audit trail
  createdBy     String? // User.id; null for the seeded baseline
  verifiedBy    String? // User.id of the person recording adviser sign-off
  verifiedAt    DateTime?
  verifiedNote  String? // e.g. "Confirmed by <firm>, ref 1234"
  createdAt     DateTime  @default(now())

  @@unique([country, effectiveFrom])
  @@index([country, effectiveFrom])
}
